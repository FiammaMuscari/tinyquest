{
  "name": "tiny-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "preview": "npm --workspace apps/web run preview",
    "typecheck": "npm --workspace apps/web run typecheck",
    "test": "node --test tests/*.test.mjs",
    "groq:smoke": "node scripts/run-groq-narration-smoke.mjs",
    "server:dev": "tsx --tsconfig tsconfig.server.json server/src/index.ts",
    "server:install": "npm install --workspace @tiny-quest/server",
    "server:go": "node scripts/run-go.mjs run ./cmd/server",
    "server:go:test": "node scripts/run-go.mjs test ./...",
    "check": "npm run typecheck && npm test && npm run server:go:test && npm run build",
    "deploy:check": "npm run check && wrangler deploy --dry-run --config apps/edge-worker/wrangler.jsonc",
    "smoke:edge": "node scripts/smoke-edge.mjs",
    "dev:edge": "npm run build && wrangler dev --config apps/edge-worker/wrangler.jsonc",
    "deploy": "npm run check && wrangler deploy --config apps/edge-worker/wrangler.jsonc"
  },
  "workspaces": [
    "apps/web",
    "packages/*",
    "server"
  ],
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "wrangler": "4.110.0"
  },
  "dependencies": {
    "boardgame.io": "^0.50.2",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.2.1"
  }
}
