MASTER_PROVIDER=groq
IMAGE_PROVIDER=mock
SOUND_PROVIDER=mock
VITE_MASTER_PROVIDER=groq
VITE_IMAGE_PROVIDER=mock
VITE_SOUND_PROVIDER=mock

# Optional local Groq test. Keep the key server-side; the Vite dev proxy reads it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Gemini y Cloudflare se leen solo desde el relay (Vite en dev / Worker en prod).
GEMINI_API_KEY=
CF_ACCOUNT_ID=
CF_AI_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Future Bedrock support
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
BEDROCK_MODEL_ID_IMAGE=
AWS_BEARER_TOKEN_BEDROCK=

# Future ElevenLabs ambient sound support
ELEVENLABS_API_KEY=

# Optional standard AWS credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
